			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"${workspaceFolder}\\scripts\\copilot-sync.ps1",
				"-Direction",
				"to-studio"
			]
		}
	]
}